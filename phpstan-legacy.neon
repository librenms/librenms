includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    phpVersion:
        min: 80200
        max: 80499

    parseModelCastsMethod: true

    resultCachePath: %tmpDir%/resultCache-legacy.php

    reportUnmatchedIgnoredErrors: false

    paths:
        - includes
        - html

    level: 0
