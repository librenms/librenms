includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    phpVersion:
        min: 80400
        max: 80599

    parseModelCastsMethod: true

    resultCachePath: %tmpDir%/resultCache-legacy.php

    reportUnmatchedIgnoredErrors: false

    paths:
        - includes
        - html

    level: 0
