[Unit]
Description=LibreNMS Scheduler
After=network.target

[Service]
Type=simple
StandardOutput=null
StandardError=null
WorkingDirectory=/opt/librenms/
ExecStart=/usr/bin/env php artisan schedule:work --no-ansi --no-interaction
User=librenms
Group=librenms
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
