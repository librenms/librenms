[Unit]
Description=LibreNMS Queue Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/librenms/
# runs horizon, reload starts a new horizon before the old one finishes its running jobs
ExecStart=/usr/bin/env php artisan worker --no-ansi --no-interaction
ExecReload=/bin/kill -HUP $MAINPID
User=librenms
Group=librenms
Restart=always
RestartSec=5
# give running polls time to finish, longer discoveries are retried after the queue retry_after
TimeoutStopSec=640
# SIGTERM to the worker command only, it stops horizon gracefully
KillMode=mixed

[Install]
WantedBy=multi-user.target
