ax3640s, axsAxrpGroupRingId,axsAxrpGroupMode,axsAxrpGroupRingAttribute,axsAxrpGroupMonitoringState,
axsAxrpGroupRingport1, axsAxrpGroupRingport2,axsAxrpGroupMultiFaultDetectionState,
