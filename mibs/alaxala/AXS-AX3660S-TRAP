
AXS-AX3660S-TRAP DEFINITIONS     ::= BEGIN
IMPORTS
TRAP-TYPE
    FROM RFC-1215
ifIndex
    FROM RFC1213-MIB
axsGsrpGroupId, axsGsrpVlanGroupId, axsGsrpState,
axsL2ldPortIndex, axsL2ldPortIfIndex, axsL2ldPortSourcePortIfindex,
axsL2ldPortDestinationPortIfindex, axsL2ldPortSourceVlan,
axsUlrPortIfIndex, axsUlrPairedPortIfIndex,
axsLoginName, axsLoginTime, axsLogoutTime, axsLoginFailureTime,
axsLoginLocation, axsLoginLine, axsLogoutStatus,
axsAxrpGroupRingId, axsAxrpGroupMode, axsAxrpGroupRingAttribute, axsAxrpGroupMonitoringState,
axsAxrpGroupRingport1, axsAxrpGroupRingport2, axsAxrpGroupMultiFaultDetectionState,
ax3660s,
ax3660sSystemMsgType, ax3660sSystemMsgTimeStamp, ax3660sSystemMsgLevel,
ax3660sSystemMsgEventPoint, ax3660sSystemMsgEventInterfaceID,
ax3660sSystemMsgEventCode, ax3660sSystemMsgAdditionalCode, ax3660sSystemMsgText,
ax3660sChassisIndex,
ax3660sTemperatureStatusIndex, ax3660sTemperatureStatusDescr,
ax3660sTemperatureStatusValue, ax3660sTemperatureState,
axsQosFlowStatsInListName, axsQosFlowStatsInSequenceNumber
    FROM AX3660S
;

-- Traps for use by AlaxalA networks AX3660S
-- Traps are defined using the conventions in RFC 1215.

ax3660sSystemMsgTrap TRAP-TYPE
    ENTERPRISE   ax3660s
    VARIABLES    {
        ax3660sSystemMsgType,
        ax3660sSystemMsgTimeStamp,
        ax3660sSystemMsgLevel,
        ax3660sSystemMsgEventPoint,
        ax3660sSystemMsgEventInterfaceID,
        ax3660sSystemMsgEventCode,
        ax3660sSystemMsgAdditionalCode,
        ax3660sSystemMsgText
    }
    DESCRIPTION
        "System message is displayed."
    ::= 1

ax3660sTemperatureTrap TRAP-TYPE
    ENTERPRISE   ax3660s
    VARIABLES    {
        ax3660sChassisIndex,
        ax3660sTemperatureStatusIndex,
        ax3660sTemperatureStatusDescr,
        ax3660sTemperatureStatusValue,
        ax3660sTemperatureState
    }
    DESCRIPTION
        "An ax3660sTemperatureTrap is sent if the temperature 
        measured at a given testpoint falls outside the normal 
        range or recovers from that state. (i.e. when becoming 
        the warning, critical, or normal state)."
    ::= 4

ax3660sGsrpStateTransitionTrap TRAP-TYPE
    ENTERPRISE   ax3660s
    VARIABLES    {
        axsGsrpGroupId,
        axsGsrpVlanGroupId,
        axsGsrpState
    }
    DESCRIPTION
        "Changes of the VLAN group state of GSRP"
    ::= 6

ax3660sAirFanStopTrap TRAP-TYPE
    ENTERPRISE   ax3660s
    DESCRIPTION
        "This trap indicates a fan failure." 
    ::= 8 

ax3660sPowerSupplyFailureTrap TRAP-TYPE
    ENTERPRISE   ax3660s
    DESCRIPTION
        "This trap indicates one ( or more ) of power supplies failure." 
    ::= 9 

ax3660sLoginSuccessTrap TRAP-TYPE
    ENTERPRISE   ax3660s
    VARIABLES    {
        axsLoginName,
        axsLoginTime,
        axsLoginLocation,
        axsLoginLine
    }
    DESCRIPTION
        "This trap indicates success of user log in." 
    ::= 10 

ax3660sLoginFailureTrap TRAP-TYPE
    ENTERPRISE   ax3660s
    VARIABLES    {
        axsLoginName,
        axsLoginFailureTime,
        axsLoginLocation,
        axsLoginLine
    }
    DESCRIPTION
        "This trap indicates failure of user log in." 
    ::= 11

ax3660sLogoutTrap TRAP-TYPE
    ENTERPRISE   ax3660s
    VARIABLES    {
        axsLoginName,
        axsLoginTime,
        axsLogoutTime,
        axsLoginLocation,
        axsLoginLine,
        axsLogoutStatus
    }
    DESCRIPTION
        "This trap indicates success of following log out.
        'logout' command, 'exit' command, 'quit' command." 
    ::= 12

ax3660sMemoryUsageTrap  TRAP-TYPE
    ENTERPRISE   ax3660s
    DESCRIPTION
        "This indicates available memory is fewer than lower limit." 
    ::= 13

ax3660sFrameErrorReceiveTrap  TRAP-TYPE
    ENTERPRISE   ax3660s
    VARIABLES    {
        ifIndex
    }
    DESCRIPTION
        "This indicates frame receive error." 
    ::= 18

ax3660sFrameErrorSendTrap  TRAP-TYPE
    ENTERPRISE   ax3660s
    VARIABLES    {
        ifIndex
    }
    DESCRIPTION
        "This indicates frame send error." 
    ::= 19

ax3660sBroadcastStormDetectTrap TRAP-TYPE
    ENTERPRISE   ax3660s
    VARIABLES    {
        ifIndex
    }
    DESCRIPTION
        "This indicates detection on broad-cast storm." 
    ::= 20

ax3660sMulticastStormDetectTrap TRAP-TYPE
    ENTERPRISE   ax3660s
    VARIABLES    {
        ifIndex
    }
    DESCRIPTION
        "This indicates detection on multi-cast storm." 
    ::= 21

ax3660sUnicastStormDetectTrap TRAP-TYPE
    ENTERPRISE   ax3660s
    VARIABLES    {
        ifIndex
    }
    DESCRIPTION
        "This indicates detection on uni-cast storm." 
    ::= 22

ax3660sBroadcastStormPortInactivateTrap TRAP-TYPE
    ENTERPRISE   ax3660s
    VARIABLES    {
        ifIndex
    }
    DESCRIPTION
        "This indicates the port inactivated for detection on broad-cast storm." 
    ::= 23

ax3660sMulticastStormPortInactivateTrap TRAP-TYPE
    ENTERPRISE   ax3660s
    VARIABLES    {
        ifIndex
    }
    DESCRIPTION
        "This indicates the port inactivated for detection on multi-cast storm." 
    ::= 24

ax3660sUnicastStormPortInactivateTrap TRAP-TYPE
    ENTERPRISE   ax3660s
    VARIABLES    {
        ifIndex
    }
    DESCRIPTION
        "This indicates the port inactivated for detection on uni-cast storm." 
    ::= 25

ax3660sBroadcastStormRecoverTrap TRAP-TYPE
    ENTERPRISE   ax3660s
    VARIABLES    {
        ifIndex
    }
    DESCRIPTION
        "This indicates the end of broad-cast storm." 
    ::= 26

ax3660sMulticastStormRecoverTrap TRAP-TYPE
    ENTERPRISE   ax3660s
    VARIABLES    {
        ifIndex
    }
    DESCRIPTION
        "This indicates the end of multi-cast storm." 
    ::= 27

ax3660sUnicastStormRecoverTrap TRAP-TYPE
    ENTERPRISE   ax3660s
    VARIABLES    {
        ifIndex
    }
    DESCRIPTION
        "This indicates the end of uni-cast storm." 
    ::= 28

ax3660sEfmoamUdldPortInactivateTrap TRAP-TYPE
    ENTERPRISE   ax3660s
    VARIABLES    {
        ifIndex
    }
    DESCRIPTION
        "Efmoam udld port inactivate trap."
    ::= 29

ax3660sEfmoamLoopDetectPortInactivateTrap TRAP-TYPE
    ENTERPRISE   ax3660s
    VARIABLES    {
        ifIndex
    }
    DESCRIPTION
        "Efmoam loop detect port inactivate trap."
    ::= 30

ax3660sAxrpStateTransitionTrap TRAP-TYPE
    ENTERPRISE   ax3660s
    VARIABLES    {
        axsAxrpGroupRingId,
        axsAxrpGroupMode,
        axsAxrpGroupRingAttribute,
        axsAxrpGroupMonitoringState
    }
    DESCRIPTION
        "When the state of the ring of ALAXALA Ring Protocol (trouble watch and restoration watch) changes between each state. "
    ::= 36

ax3660sAxrpRingport1MonitoringStartTrap TRAP-TYPE
    ENTERPRISE   ax3660s
    VARIABLES    {
        axsAxrpGroupRingId,
        axsAxrpGroupMode,
        axsAxrpGroupRingAttribute,
        axsAxrpGroupRingport1
    }
    DESCRIPTION
        "When you make the link monitoring function of ring port 1 of Ring Protocol effective. "
    ::= 37

ax3660sAxrpRingport1DownTrap TRAP-TYPE
    ENTERPRISE   ax3660s
    VARIABLES    {
        axsAxrpGroupRingId,
        axsAxrpGroupMode,
        axsAxrpGroupRingAttribute,
        axsAxrpGroupRingport1
    }
    DESCRIPTION
        "When the link for the watch is cut when the link monitoring function of ring port 1 of Ring Protocol is made effective. "
    ::= 38

ax3660sAxrpRingport2MonitoringStartTrap TRAP-TYPE
    ENTERPRISE   ax3660s
    VARIABLES    {
        axsAxrpGroupRingId,
        axsAxrpGroupMode,
        axsAxrpGroupRingAttribute,
        axsAxrpGroupRingport2
    }
    DESCRIPTION
        "When you make the link monitoring function of ring port 2 of Ring Protocol effective. "
    ::= 39

ax3660sAxrpRingport2DownTrap TRAP-TYPE
    ENTERPRISE   ax3660s
    VARIABLES    {
        axsAxrpGroupRingId,
        axsAxrpGroupMode,
        axsAxrpGroupRingAttribute,
        axsAxrpGroupRingport2
    }
    DESCRIPTION
        "When the link for the watch is cut when the link monitoring function of ring port 2 of Ring Protocol is made effective. "
    ::= 40

ax3660sAxrpMultiFaultDetectionStartTrap TRAP-TYPE
    ENTERPRISE   ax3660s
    VARIABLES    {
        axsAxrpGroupRingId,
        axsAxrpGroupMode,
        axsAxrpGroupRingAttribute
    }
    DESCRIPTION
        "When the state of watching multiple trouble on ring started."
    ::= 41

ax3660sAxrpMultiFaultDetectionStateTransitionTrap TRAP-TYPE
    ENTERPRISE   ax3660s
    VARIABLES    {
        axsAxrpGroupRingId,
        axsAxrpGroupMode,
        axsAxrpGroupRingAttribute,
        axsAxrpGroupMultiFaultDetectionState
    }
    DESCRIPTION
        "When the state of the ring of ALAXALA Ring Protocol (multiple fault detection and restoration watch) changes between each state. "
    ::= 42

ax3660sL2ldLinkDown TRAP-TYPE
    ENTERPRISE   ax3660s
    VARIABLES    {
        axsL2ldPortIfIndex,
        axsL2ldPortSourcePortIfindex,
        axsL2ldPortDestinationPortIfindex,
        axsL2ldPortSourceVlan
    }
    DESCRIPTION
        "When the operation of the interface changes from ACTIVE(state that can be communicated)
        into DISABLE (state that cannot be communicated) by the L2 loop detection."
    ::= 51

ax3660sL2ldLinkUp TRAP-TYPE
    ENTERPRISE   ax3660s
    VARIABLES    {
        axsL2ldPortIfIndex
    }
    DESCRIPTION
        "When the operation of the interface changes from DISABLE (state that cannot be communicated)
        into ACTIVE (state that can be communicated) by the automatic restoration function of the L2 loop detection."
    ::= 52

ax3660sL2ldLoopDetection TRAP-TYPE
    ENTERPRISE   ax3660s
    VARIABLES    {
        axsL2ldPortIndex,
        axsL2ldPortIfIndex,
        axsL2ldPortSourcePortIfindex,
        axsL2ldPortSourceVlan
    }
    DESCRIPTION
        "When you detect the L2 loop. It notifies every 60 seconds when the state of the L2 loop continues."
    ::= 53

ax3660sUlrChangeSecondary TRAP-TYPE
    ENTERPRISE   ax3660s
    VARIABLES    {
        axsUlrPortIfIndex,
        axsUlrPairedPortIfIndex
    }
    DESCRIPTION
        "When secondary port changed to active port."
    ::= 87

ax3660sUlrChangePrimary TRAP-TYPE
    ENTERPRISE   ax3660s
    VARIABLES    {
        axsUlrPortIfIndex,
        axsUlrPairedPortIfIndex
    }
    DESCRIPTION
        "When primary port changed to active port."
    ::= 88

ax3660sUlrActivePortDown TRAP-TYPE
    ENTERPRISE   ax3660s
    VARIABLES    {
        axsUlrPortIfIndex,
        axsUlrPairedPortIfIndex
    }
    DESCRIPTION
        "When active port disappeared."
    ::= 89

ax3660sQosFlowListRateAlarmExceedTrap TRAP-TYPE
    ENTERPRISE   ax3660s
    VARIABLES    {
        ifIndex,
        axsQosFlowStatsInListName,
        axsQosFlowStatsInSequenceNumber
    }
    DESCRIPTION
        "When the QoS flow list exceeds the rate limit."
    ::= 90

ax3660sQosFlowListRateAlarmConformTrap TRAP-TYPE
    ENTERPRISE   ax3660s
    VARIABLES    {
        ifIndex,
        axsQosFlowStatsInListName,
        axsQosFlowStatsInSequenceNumber
    }
    DESCRIPTION
        "When the QoS flow list conforms the rate limit."
    ::= 91

END
