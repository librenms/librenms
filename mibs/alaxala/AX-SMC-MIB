          axSmc9snmpOutGetResponses OBJECT-TYPE
              SYNTAX      Counter32
              MAX-ACCESS  read-only
              STATUS      obsolete
              DESCRIPTION
                      "The total number of SNMP Get-Response PDUs which
                      have been generated by the SNMP protocol entity."
              ::= { axSmc9snmp 28 }

          axSmc9snmpOutTraps OBJECT-TYPE
              SYNTAX      Counter32
              MAX-ACCESS  read-only
