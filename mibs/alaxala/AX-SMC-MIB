                        axSmc15ipv6NetToMediaNetAddress }
              ::= { axSmc15ipv6NetToMediaTable 1 }

          AxSmc15Ipv6NetToMediaEntry ::= SEQUENCE {
                  axSmc15ipv6NetToMediaNetAddress
                      Ipv6Address,
                  axSmc15ipv6NetToMediaPhysAddress
                      PhysAddress,
                  axSmc15ipv6NetToMediaType
                      INTEGER,
                  axSmc15ipv6IfNetToMediaState
                      INTEGER,
