              ::= { axSmc22ipSystemStatsEntry 40 }

          axSmc22ipSystemStatsHCOutMcastOctets OBJECT-TYPE
              SYNTAX     Counter64
              MAX-ACCESS read-only
              STATUS     current
              DESCRIPTION
                     "The total number of octets transmitted in IP multicast
