                        Counter32      ,
                  axSmc2ipv6IfIcmpOutDestUnreachs
                        Counter32      ,
                  axSmc2ipv6IfIcmpOutAdminProhibs
                        Counter32      ,
                  axSmc2ipv6IfIcmpOutTimeExcds
                        Counter32      ,
                  axSmc2ipv6IfIcmpOutParmProblems
                        Counter32      ,
                  axSmc2ipv6IfIcmpOutPktTooBigs
                        Counter32      ,
                  axSmc2ipv6IfIcmpOutEchos
