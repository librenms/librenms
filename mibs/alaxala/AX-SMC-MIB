          axSmc9tcpConnectionState OBJECT-TYPE
              SYNTAX     INTEGER {
                              closed(1),
                              listen(2),
                              synSent(3),
                              synReceived(4),
                              established(5),
                              finWait1(6),
                              finWait2(7),
                              closeWait(8),
                              lastAck(9),
                              closing(10),
                              timeWait(11),
                              deleteTCB(12)
                          }
              MAX-ACCESS read-write
              STATUS     current
              DESCRIPTION
