                        Counter32      ,
                  axSmc24ipv6IfIcmpOutMsgs
                        Counter32      ,
                  axSmc24ipv6IfIcmpOutErrors
                        Counter32      ,
                  axSmc24ipv6IfIcmpOutDestUnreachs
                        Counter32      ,
                  axSmc24ipv6IfIcmpOutAdminProhibs
                        Counter32      ,
                  axSmc24ipv6IfIcmpOutTimeExcds
                        Counter32      ,
