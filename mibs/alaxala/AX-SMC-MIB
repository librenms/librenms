                  axSmc8ipv6IfIcmpOutErrors
                        Counter32      ,
                  axSmc8ipv6IfIcmpOutDestUnreachs
                        Counter32      ,
                  axSmc8ipv6IfIcmpOutAdminProhibs
                        Counter32      ,
                  axSmc8ipv6IfIcmpOutTimeExcds
                        Counter32      ,
                  axSmc8ipv6IfIcmpOutParmProblems
                        Counter32      ,
