                  axSmc12ipv6IfIcmpOutErrors
                        Counter32      ,
                  axSmc12ipv6IfIcmpOutDestUnreachs
                        Counter32      ,
                  axSmc12ipv6IfIcmpOutAdminProhibs
                        Counter32      ,
