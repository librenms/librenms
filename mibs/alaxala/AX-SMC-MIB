                        axSmc7ipv6NetToMediaNetAddress }
              ::= { axSmc7ipv6NetToMediaTable 1 }

          AxSmc7Ipv6NetToMediaEntry ::= SEQUENCE {
                  axSmc7ipv6NetToMediaNetAddress
                      Ipv6Address,
