                        Counter32      ,
                  axSmc14ipv6IfIcmpOutDestUnreachs
                        Counter32      ,
                  axSmc14ipv6IfIcmpOutAdminProhibs
                        Counter32      ,
                  axSmc14ipv6IfIcmpOutTimeExcds
