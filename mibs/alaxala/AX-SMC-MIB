                        Counter32      ,
                  axSmc10ipv6IfIcmpOutDestUnreachs
                        Counter32      ,
                  axSmc10ipv6IfIcmpOutAdminProhibs
                        Counter32      ,
                  axSmc10ipv6IfIcmpOutTimeExcds
                        Counter32      ,
                  axSmc10ipv6IfIcmpOutParmProblems
