              ::= { axSmc9snmp 20 }

          axSmc9snmpOutNoSuchNames OBJECT-TYPE
              SYNTAX      Counter32
              MAX-ACCESS  read-only
              STATUS      obsolete
              DESCRIPTION
                      "The total number of SNMP PDUs which were generated
                      by the SNMP protocol entity and for which the value
