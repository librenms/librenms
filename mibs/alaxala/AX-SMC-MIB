                  axSmc4ipv6IfIcmpOutMsgs
                        Counter32      ,
                  axSmc4ipv6IfIcmpOutErrors
                        Counter32      ,
                  axSmc4ipv6IfIcmpOutDestUnreachs
                        Counter32      ,
                  axSmc4ipv6IfIcmpOutAdminProhibs
                        Counter32      ,
                  axSmc4ipv6IfIcmpOutTimeExcds
                        Counter32      ,
