
AXS-AX1240S-TRAP DEFINITIONS ::= BEGIN
IMPORTS
enterprises
        FROM RFC1155-SMI
OBJECT-TYPE
        FROM RFC-1212
TRAP-TYPE
        FROM RFC-1215
ifIndex, DisplayString
        FROM RFC1213-MIB
MacAddress
        FROM SNMPv2-TC
ax1240s, ax1240sSystemMsgType, ax1240sSystemMsgTimeStamp,
ax1240sSystemMsgLevel, ax1240sSystemMsgEventPoint,
ax1240sSystemMsgEventInterfaceID, ax1240sSystemMsgEventCode,
ax1240sSystemMsgAdditionalCode, ax1240sSystemMsgText,
ax1240sChassisIndex, ax1240sTemperatureStatusIndex, ax1240sTemperatureStatusDescr,
ax1240sTemperatureStatusValue, ax1240sTemperatureState,
axsLoginName, axsLoginTime, axsLoginLocation, axsLoginLine,
axsLoginFailureTime, axsLogoutTime, axsLogoutStatus,
axsL2ldPortIndex, axsL2ldPortIfIndex, axsL2ldPortSourcePortIfindex,
axsL2ldPortDestinationPortIfindex, axsL2ldPortSourceVlan,
axsUlrPortIfIndex, axsUlrPairedPortIfIndex, ax1240sMemoryError, ax1240sAuthInfo
        FROM AX1240S
;

-- Traps for use by AlaxalA networks AX1240S

-- Traps are defined using the conventions in RFC 1215.

-- ax1240sAuth group

ax1240sAuthSysName OBJECT-TYPE
	SYNTAX  DisplayString (SIZE (0..60))
	ACCESS  not-accessible
	STATUS  mandatory
	DESCRIPTION
		"System name of authentication."
	::= { ax1240sAuthInfo 1 }

ax1240sAuthIfIndex OBJECT-TYPE
	SYNTAX  INTEGER
	ACCESS  not-accessible
	STATUS  mandatory
	DESCRIPTION
		"ifIndex of authentication."
	::= { ax1240sAuthInfo 2 }

ax1240sAuthSupplicantMac OBJECT-TYPE
	SYNTAX  MacAddress
	ACCESS  not-accessible
	STATUS  mandatory
	DESCRIPTION
		"Mac address of authentication."
	::= { ax1240sAuthInfo 3 }

ax1240sAuthMessage OBJECT-TYPE
	SYNTAX  DisplayString (SIZE (0..280))
	ACCESS  not-accessible
	STATUS  mandatory
	DESCRIPTION
		"Message of authentication."
	::= { ax1240sAuthInfo 4 }

ax1240sSystemMsgTrap TRAP-TYPE
	ENTERPRISE      ax1240s
	VARIABLES       { ax1240sSystemMsgType, ax1240sSystemMsgTimeStamp,
                          ax1240sSystemMsgLevel, ax1240sSystemMsgEventPoint,
                          ax1240sSystemMsgEventInterfaceID, ax1240sSystemMsgEventCode,
                          ax1240sSystemMsgAdditionalCode, ax1240sSystemMsgText }
	DESCRIPTION
		"System message is displayed."
	::= 1

ax1240sTemperatureTrap TRAP-TYPE
	ENTERPRISE ax1240s
	VARIABLES {
		ax1240sChassisIndex,
		ax1240sTemperatureStatusIndex,
		ax1240sTemperatureStatusDescr, 
		ax1240sTemperatureStatusValue, 
		ax1240sTemperatureState }
	DESCRIPTION
		"A ax1240sTemperatureTrap is sent if the 
		temperature measured at a given testpoint is outside 
		the normal range for the testpoint (i.e. is at the warning, 
		critical, or shutdown stage)."
	::= 4

ax1240sAirFanStopTrap TRAP-TYPE
	ENTERPRISE      ax1240s
	DESCRIPTION
             "This trap indicates a fan failure." 
	::= 8 

ax1240sPowerSupplyFailureTrap TRAP-TYPE
	ENTERPRISE      ax1240s
	DESCRIPTION
             "This trap indicates one ( or more ) of power supplies failure." 
	::= 9 

ax1240sLoginSuccessTrap TRAP-TYPE
	ENTERPRISE      ax1240s
	VARIABLES       { axsLoginName, axsLoginTime, axsLoginLocation, axsLoginLine }
	DESCRIPTION
             "This trap indicates success of user log in." 
	::= 10 

ax1240sLoginFailureTrap TRAP-TYPE
	ENTERPRISE      ax1240s
	VARIABLES       { axsLoginName, axsLoginFailureTime, 
                          axsLoginLocation, axsLoginLine }
	DESCRIPTION
             "This trap indicates failure of user log in." 
	::= 11

ax1240sLogoutTrap TRAP-TYPE
	ENTERPRISE      ax1240s
	VARIABLES       { axsLoginName, axsLoginTime, axsLogoutTime, 
                          axsLoginLocation, axsLoginLine, axsLogoutStatus }
	DESCRIPTION
             "This trap indicates success of following log out.
	       'logout' command, 'exit' command, 'quit' command." 
	::= 12

ax1240sMemoryUsageTrap  TRAP-TYPE
	ENTERPRISE      ax1240s
	DESCRIPTION
             "This indicates available memory is fewer than lower limit." 
	::= 13

ax1240sFrameErrorReceiveTrap  TRAP-TYPE
	ENTERPRISE      ax1240s
	VARIABLES       { ifIndex }
	DESCRIPTION
             "This indicates frame receive error." 
	::= 18

ax1240sFrameErrorSendTrap  TRAP-TYPE
	ENTERPRISE      ax1240s
	VARIABLES       { ifIndex }
	DESCRIPTION
             "This indicates frame send error." 
	::= 19

--axsBroadcastStormDetectTrap TRAP-TYPE
ax1240sBroadcastStormDetectTrap TRAP-TYPE
	ENTERPRISE      ax1240s
	VARIABLES       { ifIndex }
	DESCRIPTION
