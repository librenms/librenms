--axsUnicastStormPortInactivateTrap TRAP-TYPE
ax1240sUnicastStormPortInactivateTrap TRAP-TYPE
	ENTERPRISE      ax1240s
	VARIABLES       { ifIndex }
	DESCRIPTION
             "This indicates the port inactivated for decection on uni-cast storm." 
	::= 25

--axsBroadcastStormRecoverTrap TRAP-TYPE
ax1240sBroadcastStormRecoverTrap TRAP-TYPE
	ENTERPRISE      ax1240s
	VARIABLES       { ifIndex }
	DESCRIPTION
             "This indicates the end of broad-cast storm." 
	::= 26

--axsMulticastStormRecoverTrap TRAP-TYPE
ax1240sMulticastStormRecoverTrap TRAP-TYPE
	ENTERPRISE      ax1240s
	VARIABLES       { ifIndex }
	DESCRIPTION
             "This indicates the end of multi-cast storm." 
	::= 27
	
--axsUnicastStormRecoverTrap TRAP-TYPE
ax1240sUnicastStormRecoverTrap TRAP-TYPE
	ENTERPRISE      ax1240s
	VARIABLES       { ifIndex }
	DESCRIPTION
             "This indicates the end of uni-cast storm." 
	::= 28
	
--axsEfmoamUdldPortInactivateTrap TRAP-TYPE
ax1240sEfmoamUdldPortInactivateTrap TRAP-TYPE
	ENTERPRISE      ax1240s
	VARIABLES       { ifIndex }
	DESCRIPTION
             "Efmoam udld port inactivate trap."
	::= 29

--axsEfmoamLoopDetectPortInactivateTrap TRAP-TYPE
ax1240sEfmoamLoopDetectPortInactivateTrap TRAP-TYPE
	ENTERPRISE      ax1240s
	VARIABLES       { ifIndex }
	DESCRIPTION
             "Efmoam loop detect port inactivate trap."
	::= 30

ax1240sDot1xFailureTrap  TRAP-TYPE
	ENTERPRISE      ax1240s
	VARIABLES       { ax1240sAuthSysName, ax1240sAuthIfIndex, ax1240sAuthSupplicantMac, ax1240sAuthMessage }
	DESCRIPTION
             "Private trap of 802.1X authentication failure." 
	::= 31

ax1240sDot1xEventTrap  TRAP-TYPE
	ENTERPRISE      ax1240s
	VARIABLES       { ax1240sAuthSysName, ax1240sAuthIfIndex, ax1240sAuthSupplicantMac, ax1240sAuthMessage }
	DESCRIPTION
             "Private trap of 802.1X authentication event." 
	::= 32

ax1240sWauthFailureTrap  TRAP-TYPE
	ENTERPRISE      ax1240s
	VARIABLES       { ax1240sAuthSysName, ax1240sAuthIfIndex, ax1240sAuthSupplicantMac, ax1240sAuthMessage }
	DESCRIPTION
             "Private trap of Web authentication failure." 
	::= 33

ax1240sWauthEventTrap  TRAP-TYPE
	ENTERPRISE      ax1240s
	VARIABLES       { ax1240sAuthSysName, ax1240sAuthIfIndex, ax1240sAuthSupplicantMac, ax1240sAuthMessage }
	DESCRIPTION
             "Private trap of Web authentication event." 
