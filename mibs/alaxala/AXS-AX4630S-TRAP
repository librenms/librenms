
AXS-AX4630S-TRAP DEFINITIONS     ::= BEGIN
IMPORTS
TRAP-TYPE
    FROM RFC-1215
ifIndex
    FROM RFC1213-MIB
axsGsrpGroupId, axsGsrpVlanGroupId, axsGsrpState,
axsL2ldPortIndex, axsL2ldPortIfIndex, axsL2ldPortSourcePortIfindex,
axsL2ldPortDestinationPortIfindex, axsL2ldPortSourceVlan,
axsUlrPortIfIndex, axsUlrPairedPortIfIndex,
axsLoginName, axsLoginTime, axsLogoutTime, axsLoginFailureTime,
axsLoginLocation, axsLoginLine, axsLogoutStatus,
axsAxrpGroupRingId, axsAxrpGroupMode, axsAxrpGroupRingAttribute, axsAxrpGroupMonitoringState,
axsAxrpGroupRingport1, axsAxrpGroupRingport2, axsAxrpGroupMultiFaultDetectionState,
ax4630s,
ax4630sSystemMsgType, ax4630sSystemMsgTimeStamp, ax4630sSystemMsgLevel,
ax4630sSystemMsgEventPoint, ax4630sSystemMsgEventInterfaceID,
ax4630sSystemMsgEventCode, ax4630sSystemMsgAdditionalCode, ax4630sSystemMsgText,
ax4630sChassisIndex,
ax4630sTemperatureStatusIndex, ax4630sTemperatureStatusDescr,
ax4630sTemperatureStatusValue, ax4630sTemperatureState, ax4630sNifBoardSlotIndex
    FROM AX4630S
;

-- Traps for use by AlaxalA networks AX4630S
-- Traps are defined using the conventions in RFC 1215.

ax4630sSystemMsgTrap TRAP-TYPE
    ENTERPRISE   ax4630s
    VARIABLES    {
        ax4630sSystemMsgType,
        ax4630sSystemMsgTimeStamp,
        ax4630sSystemMsgLevel,
        ax4630sSystemMsgEventPoint,
        ax4630sSystemMsgEventInterfaceID,
        ax4630sSystemMsgEventCode,
        ax4630sSystemMsgAdditionalCode,
        ax4630sSystemMsgText
    }
    DESCRIPTION
        "System message is displayed."
    ::= 1

ax4630sTemperatureTrap TRAP-TYPE
    ENTERPRISE   ax4630s
    VARIABLES    {
        ax4630sChassisIndex,
        ax4630sTemperatureStatusIndex,
        ax4630sTemperatureStatusDescr,
        ax4630sTemperatureStatusValue,
        ax4630sTemperatureState
    }
    DESCRIPTION
        "A ax4630sTemperatureTrap is sent if the 
        temperature measured at a given testpoint is outside 
        the normal range for the testpoint (i.e. is at the warning,
        critical, or shutdown stage)."
    ::= 4

ax4630sGsrpStateTransitionTrap TRAP-TYPE
    ENTERPRISE   ax4630s
    VARIABLES    {
        axsGsrpGroupId,
        axsGsrpVlanGroupId,
        axsGsrpState
    }
    DESCRIPTION
        "Changes of the VLAN group state of GSRP"
    ::= 6

ax4630sAirFanStopTrap TRAP-TYPE
    ENTERPRISE   ax4630s
    DESCRIPTION
        "This trap indicates a fan failure." 
    ::= 8 

ax4630sPowerSupplyFailureTrap TRAP-TYPE
    ENTERPRISE   ax4630s
    DESCRIPTION
        "This trap indicates one ( or more ) of power supplies failure." 
    ::= 9 

ax4630sLoginSuccessTrap TRAP-TYPE
    ENTERPRISE   ax4630s
    VARIABLES    {
        axsLoginName,
        axsLoginTime,
        axsLoginLocation,
        axsLoginLine
    }
    DESCRIPTION
        "This trap indicates success of user log in." 
    ::= 10 

ax4630sLoginFailureTrap TRAP-TYPE
    ENTERPRISE   ax4630s
    VARIABLES    {
        axsLoginName,
        axsLoginFailureTime,
        axsLoginLocation,
        axsLoginLine
    }
    DESCRIPTION
        "This trap indicates failure of user log in." 
    ::= 11

ax4630sLogoutTrap TRAP-TYPE
    ENTERPRISE   ax4630s
    VARIABLES    {
        axsLoginName,
        axsLoginTime,
        axsLogoutTime,
        axsLoginLocation,
        axsLoginLine,
        axsLogoutStatus
    }
    DESCRIPTION
        "This trap indicates success of following log out.
        'logout' command, 'exit' command, 'quit' command." 
    ::= 12

ax4630sMemoryUsageTrap  TRAP-TYPE
    ENTERPRISE   ax4630s
    DESCRIPTION
        "This indicates available memory is fewer than lower limit." 
    ::= 13

ax4630sFrameErrorReceiveTrap  TRAP-TYPE
    ENTERPRISE   ax4630s
    VARIABLES    {
        ifIndex
    }
    DESCRIPTION
        "This indicates frame receive error." 
    ::= 18

ax4630sFrameErrorSendTrap  TRAP-TYPE
    ENTERPRISE   ax4630s
    VARIABLES    {
        ifIndex
    }
    DESCRIPTION
        "This indicates frame send error." 
    ::= 19

ax4630sBroadcastStormDetectTrap TRAP-TYPE
    ENTERPRISE   ax4630s
    VARIABLES    {
        ifIndex
    }
    DESCRIPTION
        "This indicates detection on broad-cast storm." 
    ::= 20

ax4630sMulticastStormDetectTrap TRAP-TYPE
    ENTERPRISE   ax4630s
    VARIABLES    {
        ifIndex
    }
    DESCRIPTION
        "This indicates detection on multi-cast storm." 
    ::= 21

ax4630sUnicastStormDetectTrap TRAP-TYPE
    ENTERPRISE   ax4630s
    VARIABLES    {
        ifIndex
    }
    DESCRIPTION
        "This indicates detection on uni-cast storm." 
    ::= 22

ax4630sBroadcastStormPortInactivateTrap TRAP-TYPE
    ENTERPRISE   ax4630s
    VARIABLES    {
        ifIndex
    }
    DESCRIPTION
        "This indicates the port inactivated for detection on broad-cast storm." 
    ::= 23

ax4630sMulticastStormPortInactivateTrap TRAP-TYPE
    ENTERPRISE   ax4630s
    VARIABLES    {
        ifIndex
    }
    DESCRIPTION
        "This indicates the port inactivated for detection on multi-cast storm." 
    ::= 24

ax4630sUnicastStormPortInactivateTrap TRAP-TYPE
    ENTERPRISE   ax4630s
    VARIABLES    {
        ifIndex
    }
    DESCRIPTION
        "This indicates the port inactivated for detection on uni-cast storm." 
    ::= 25

ax4630sBroadcastStormRecoverTrap TRAP-TYPE
    ENTERPRISE   ax4630s
    VARIABLES    {
        ifIndex
    }
    DESCRIPTION
        "This indicates the end of broad-cast storm." 
    ::= 26

ax4630sMulticastStormRecoverTrap TRAP-TYPE
    ENTERPRISE   ax4630s
    VARIABLES    {
        ifIndex
    }
    DESCRIPTION
        "This indicates the end of multi-cast storm." 
    ::= 27

ax4630sUnicastStormRecoverTrap TRAP-TYPE
    ENTERPRISE   ax4630s
    VARIABLES    {
        ifIndex
    }
    DESCRIPTION
        "This indicates the end of multi-cast storm." 
    ::= 28

ax4630sEfmoamUdldPortInactivateTrap TRAP-TYPE
    ENTERPRISE   ax4630s
    VARIABLES    {
        ifIndex
    }
    DESCRIPTION
        "Efmoam udld port inactivate trap."
    ::= 29

ax4630sEfmoamLoopDetectPortInactivateTrap TRAP-TYPE
    ENTERPRISE   ax4630s
    VARIABLES    {
        ifIndex
    }
    DESCRIPTION
        "Efmoam loop detect port inactivate trap."
    ::= 30

ax4630sAxrpStateTransitionTrap TRAP-TYPE
    ENTERPRISE   ax4630s
    VARIABLES    {
        axsAxrpGroupRingId,
        axsAxrpGroupMode,
        axsAxrpGroupRingAttribute,
        axsAxrpGroupMonitoringState
    }
    DESCRIPTION
        "When the state of the ring of ALAXALA Ring Protocol (trouble watch and restoration watch) changes between each state. "
    ::= 36

ax4630sAxrpRingport1MonitoringStartTrap TRAP-TYPE
    ENTERPRISE   ax4630s
    VARIABLES    {
        axsAxrpGroupRingId,
        axsAxrpGroupMode,
        axsAxrpGroupRingAttribute,
        axsAxrpGroupRingport1
    }
    DESCRIPTION
        "When you make the link monitoring function of ring port 1 of Ring Protocol effective. "
    ::= 37

ax4630sAxrpRingport1DownTrap TRAP-TYPE
    ENTERPRISE   ax4630s
    VARIABLES    {
        axsAxrpGroupRingId,
        axsAxrpGroupMode,
        axsAxrpGroupRingAttribute,
        axsAxrpGroupRingport1
    }
    DESCRIPTION
        "When the link for the watch is cut when the link monitoring function of ring port 1 of Ring Protocol is made effective. "
    ::= 38

ax4630sAxrpRingport2MonitoringStartTrap TRAP-TYPE
    ENTERPRISE   ax4630s
    VARIABLES    {
        axsAxrpGroupRingId,
        axsAxrpGroupMode,
        axsAxrpGroupRingAttribute,
        axsAxrpGroupRingport2
    }
    DESCRIPTION
        "When you make the link monitoring function of ring port 2 of Ring Protocol effective. "
    ::= 39

ax4630sAxrpRingport2DownTrap TRAP-TYPE
    ENTERPRISE   ax4630s
    VARIABLES    {
        axsAxrpGroupRingId,
        axsAxrpGroupMode,
        axsAxrpGroupRingAttribute,
        axsAxrpGroupRingport2
    }
    DESCRIPTION
        "When the link for the watch is cut when the link monitoring function of ring port 2 of Ring Protocol is made effective. "
    ::= 40

ax4630sAxrpMultiFaultDetectionStartTrap TRAP-TYPE
    ENTERPRISE   ax4630s
    VARIABLES    {
        axsAxrpGroupRingId,
        axsAxrpGroupMode,
        axsAxrpGroupRingAttribute
    }
    DESCRIPTION
        "When the state of watching multiple trouble on ring started."
    ::= 41

ax4630sAxrpMultiFaultDetectionStateTransitionTrap TRAP-TYPE
    ENTERPRISE   ax4630s
    VARIABLES    {
        axsAxrpGroupRingId,
        axsAxrpGroupMode,
        axsAxrpGroupRingAttribute,
        axsAxrpGroupMultiFaultDetectionState
    }
    DESCRIPTION
        "When the state of the ring of ALAXALA Ring Protocol (multiple fault detection and restoration watch) changes between each state. "
    ::= 42

ax4630sL2ldLinkDown TRAP-TYPE
    ENTERPRISE   ax4630s
    VARIABLES    {
        axsL2ldPortIfIndex,
        axsL2ldPortSourcePortIfindex,
        axsL2ldPortDestinationPortIfindex,
        axsL2ldPortSourceVlan
    }
    DESCRIPTION
        "When the operation of the interface changes from ACTIVE(state that can be communicated)
        into DISABLE (state that cannot be communicated) by the L2 loop detection."
    ::= 51

ax4630sL2ldLinkUp TRAP-TYPE
    ENTERPRISE   ax4630s
    VARIABLES    {
        axsL2ldPortIfIndex
    }
    DESCRIPTION
        "When the operation of the interface changes from DISABLE (state that cannot be communicated)
        into ACTIVE (state that can be communicated) by the automatic restoration function of the L2 loop detection."
    ::= 52

ax4630sL2ldLoopDetection TRAP-TYPE
    ENTERPRISE   ax4630s
    VARIABLES    {
        axsL2ldPortIndex,
        axsL2ldPortIfIndex,
        axsL2ldPortSourcePortIfindex,
        axsL2ldPortSourceVlan
    }
    DESCRIPTION
        "When you detect the L2 loop. It notifies every 60 seconds when the state of the L2 loop continues."
    ::= 53

ax4630sUlrChangeSecondary TRAP-TYPE
    ENTERPRISE   ax4630s
    VARIABLES    {
        axsUlrPortIfIndex,
        axsUlrPairedPortIfIndex
    }
    DESCRIPTION
        "When secondary port changed to active port."
    ::= 87

ax4630sUlrChangePrimary TRAP-TYPE
    ENTERPRISE   ax4630s
    VARIABLES    {
        axsUlrPortIfIndex,
        axsUlrPairedPortIfIndex
    }
    DESCRIPTION
        "When primary port changed to active port."
    ::= 88

ax4630sUlrActivePortDown TRAP-TYPE
    ENTERPRISE   ax4630s
    VARIABLES    {
        axsUlrPortIfIndex,
        axsUlrPairedPortIfIndex
    }
    DESCRIPTION
        "When active port disappeared."
    ::= 89

END
