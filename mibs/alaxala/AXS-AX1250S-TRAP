
AXS-AX1250S-TRAP DEFINITIONS ::= BEGIN
IMPORTS
enterprises
        FROM RFC1155-SMI
OBJECT-TYPE
        FROM RFC-1212
TRAP-TYPE
        FROM RFC-1215
ifIndex, DisplayString
        FROM RFC1213-MIB
MacAddress
        FROM SNMPv2-TC
ax1250s, ax1250sSystemMsgType, ax1250sSystemMsgTimeStamp,
ax1250sSystemMsgLevel, ax1250sSystemMsgEventPoint,
ax1250sSystemMsgEventInterfaceID, ax1250sSystemMsgEventCode,
ax1250sSystemMsgAdditionalCode, ax1250sSystemMsgText,
ax1250sChassisIndex, ax1250sTemperatureStatusIndex, ax1250sTemperatureStatusDescr,
ax1250sTemperatureStatusValue, ax1250sTemperatureState,
axsLoginName, axsLoginTime, axsLoginLocation, axsLoginLine,
axsLoginFailureTime, axsLogoutTime, axsLogoutStatus,
axsL2ldPortIndex, axsL2ldPortIfIndex, axsL2ldPortSourcePortIfindex,
axsL2ldPortDestinationPortIfindex, axsL2ldPortSourceVlan,
axsUlrPortIfIndex, axsUlrPairedPortIfIndex, ax1250sMemoryError, ax1250sAuthInfo
        FROM AX1240S
;

-- Traps for use by AlaxalA networks AX1250S

-- Traps are defined using the conventions in RFC 1215.

-- ax1250sAuth group

ax1250sAuthSysName OBJECT-TYPE
	SYNTAX  DisplayString (SIZE (0..60))
	ACCESS  not-accessible
	STATUS  mandatory
	DESCRIPTION
		"System name of authentication."
	::= { ax1250sAuthInfo 1 }

ax1250sAuthIfIndex OBJECT-TYPE
	SYNTAX  INTEGER
	ACCESS  not-accessible
	STATUS  mandatory
	DESCRIPTION
		"ifIndex of authentication."
	::= { ax1250sAuthInfo 2 }

ax1250sAuthSupplicantMac OBJECT-TYPE
	SYNTAX  MacAddress
	ACCESS  not-accessible
	STATUS  mandatory
	DESCRIPTION
		"Mac address of authentication."
	::= { ax1250sAuthInfo 3 }

ax1250sAuthMessage OBJECT-TYPE
	SYNTAX  DisplayString (SIZE (0..280))
	ACCESS  not-accessible
	STATUS  mandatory
	DESCRIPTION
		"Message of authentication."
	::= { ax1250sAuthInfo 4 }

ax1250sSystemMsgTrap TRAP-TYPE
	ENTERPRISE      ax1250s
	VARIABLES       { ax1250sSystemMsgType, ax1250sSystemMsgTimeStamp,
                          ax1250sSystemMsgLevel, ax1250sSystemMsgEventPoint,
                          ax1250sSystemMsgEventInterfaceID, ax1250sSystemMsgEventCode,
                          ax1250sSystemMsgAdditionalCode, ax1250sSystemMsgText }
	DESCRIPTION
		"System message is displayed."
	::= 1

ax1250sTemperatureTrap TRAP-TYPE
	ENTERPRISE ax1250s
	VARIABLES {
		ax1250sChassisIndex,
		ax1250sTemperatureStatusIndex,
		ax1250sTemperatureStatusDescr, 
		ax1250sTemperatureStatusValue, 
		ax1250sTemperatureState }
	DESCRIPTION
		"A ax1250sTemperatureTrap is sent if the 
		temperature measured at a given testpoint is outside 
		the normal range for the testpoint (i.e. is at the warning, 
		critical, or shutdown stage)."
	::= 4

ax1250sAirFanStopTrap TRAP-TYPE
	ENTERPRISE      ax1250s
	DESCRIPTION
             "This trap indicates a fan failure." 
	::= 8 

ax1250sPowerSupplyFailureTrap TRAP-TYPE
	ENTERPRISE      ax1250s
	DESCRIPTION
             "This trap indicates one ( or more ) of power supplies failure." 
	::= 9 

ax1250sLoginSuccessTrap TRAP-TYPE
	ENTERPRISE      ax1250s
	VARIABLES       { axsLoginName, axsLoginTime, axsLoginLocation, axsLoginLine }
	DESCRIPTION
             "This trap indicates success of user log in." 
	::= 10 

ax1250sLoginFailureTrap TRAP-TYPE
	ENTERPRISE      ax1250s
	VARIABLES       { axsLoginName, axsLoginFailureTime, 
                          axsLoginLocation, axsLoginLine }
	DESCRIPTION
             "This trap indicates failure of user log in." 
	::= 11

ax1250sLogoutTrap TRAP-TYPE
	ENTERPRISE      ax1250s
	VARIABLES       { axsLoginName, axsLoginTime, axsLogoutTime, 
                          axsLoginLocation, axsLoginLine, axsLogoutStatus }
	DESCRIPTION
             "This trap indicates success of following log out.
	       'logout' command, 'exit' command, 'quit' command." 
	::= 12

ax1250sMemoryUsageTrap  TRAP-TYPE
	ENTERPRISE      ax1250s
	DESCRIPTION
             "This indicates available memory is fewer than lower limit." 
	::= 13

ax1250sFrameErrorReceiveTrap  TRAP-TYPE
	ENTERPRISE      ax1250s
	VARIABLES       { ifIndex }
	DESCRIPTION
             "This indicates frame receive error." 
	::= 18

ax1250sFrameErrorSendTrap  TRAP-TYPE
	ENTERPRISE      ax1250s
	VARIABLES       { ifIndex }
	DESCRIPTION
             "This indicates frame send error." 
	::= 19

--axsBroadcastStormDetectTrap TRAP-TYPE
ax1250sBroadcastStormDetectTrap TRAP-TYPE
