	::= {teravar 30}

teraSwitchFromCon OBJECT-TYPE
	SYNTAX		Integer32
	ACCESS		read-only
	STATUS		mandatory
	DESCRIPTION	"CON ID"
	::= {teravar 31}

teraSwitchCpu OBJECT-TYPE
	SYNTAX		Integer32
	ACCESS		read-only
	STATUS		mandatory
