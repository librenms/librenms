teraFan2Status OBJECT-TYPE
	SYNTAX		INTEGER {
					unknown(0),
					okay(1),
					faulty(2)
				}
	ACCESS		read-only
	STATUS		mandatory
	DESCRIPTION	"Status of fan tray #2"
	::= {teravar 42}

teraFan2Speed OBJECT-TYPE
	SYNTAX		Integer32
	ACCESS		read-only
	STATUS		mandatory
	DESCRIPTION	"Speed of fan tray #2 in steps
	min: 0, max: 15"
	::= {teravar 43}

teraPower1Status OBJECT-TYPE
