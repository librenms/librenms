PIKTIME-OSTT-MIB DEFINITIONS ::= BEGIN
--
-- The MIB module for Optical System for Time Transfer 
--
IMPORTS
	MODULE-IDENTITY, OBJECT-TYPE, Integer32, NOTIFICATION-TYPE FROM SNMPv2-SMI
    DisplayString, MacAddress, DateAndTime, TEXTUAL-CONVENTION FROM SNMPv2-TC
	MODULE-COMPLIANCE, OBJECT-GROUP, NOTIFICATION-GROUP FROM SNMPv2-CONF
	piktime FROM PIKTIME-SMI-MIB;

FloatOnePointPrecision ::= TEXTUAL-CONVENTION
    DISPLAY-HINT "d-1"
    STATUS current
    DESCRIPTION
        "Represents a value with 1 decimal point precision"
    SYNTAX Integer32

-- 1.3.6.1.4.1.49224.2
ostt MODULE-IDENTITY
    LAST-UPDATED 	"202604290000Z"
    ORGANIZATION 	"PikTime Systems"
    CONTACT-INFO 	"www.piktime.com"
    DESCRIPTION  	"Optical System for Time Transfer"
    REVISION 		"202604290000Z"
    DESCRIPTION 	"Administrative update."
    REVISION 		"202310070000Z"
    DESCRIPTION		" "
    ::= { piktime 2 }

--  General information of OSTT device ***************************************************************
-- 1.3.6.1.4.1.49224.2.5
osttDevice        OBJECT IDENTIFIER ::= { ostt 5 }

-- 1.3.6.1.4.1.49224.2.5.1
osttDevGeneral   	OBJECT IDENTIFIER 
--	DESCRIPTION "General information of OSTT device, common for all devices "
	::= { osttDevice 1 }

-- 1.3.6.1.4.1.49224.2.5.1.1
osttDevGenObjects   	OBJECT IDENTIFIER ::= { osttDevGeneral 1 }

-- 1.3.6.1.4.1.49224.2.5.1.1.1
osttDevGenObInfo   	OBJECT IDENTIFIER ::= { osttDevGenObjects 1 }

--  MIB groups : Device information ********************************

-- 1.3.6.1.4.1.49224.2.5.1.1.1.1
osttDevGenObInTypeDefiniton OBJECT-TYPE
    SYNTAX INTEGER {
                    generic(1),
                    local(2),
                    remote(3),
                    oba(4),
                    oba3(5),
                    oba32(52),
                    localdi(6),
                    remotedi(7)
                   }
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "Device Type (generic, local, remote, oba, oba3, oba3_2, localdi, remotedi)"
    ::= { osttDevGenObInfo 1 }

-- 1.3.6.1.4.1.49224.2.5.1.1.1.2
osttDevGenObInDataUpdate OBJECT-TYPE
    SYNTAX DisplayString (SIZE (0..100))
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION  "Date and time  of last data update"
    ::= { osttDevGenObInfo 2 }

-- 1.3.6.1.4.1.49224.2.5.1.1.1.3
osttDevGenObInVersionNumber OBJECT-TYPE
    SYNTAX DisplayString (SIZE (0..100))
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Device Version Number"
    ::= { osttDevGenObInfo 3 }

-- 1.3.6.1.4.1.49224.2.5.1.1.1.4
osttDevGenObInSerialNumber OBJECT-TYPE
    SYNTAX DisplayString (SIZE (0..100))
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Device Serial Number"
    ::= { osttDevGenObInfo 4 }

-- 1.3.6.1.4.1.49224.2.5.1.1.1.5
osttDevGenObInStatus OBJECT-TYPE
    SYNTAX INTEGER {
                    normal(1),
                    user(2),
                    service(3),
                    malfunction(4)
                   }
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "Operational status of the device"
    DEFVAL { normal	}
    ::= { osttDevGenObInfo 5 }

-- 1.3.6.1.4.1.49224.2.5.1.1.1.6
osttDevGenObInLocation OBJECT-TYPE
    SYNTAX DisplayString (SIZE (0..100))
    MAX-ACCESS read-only
