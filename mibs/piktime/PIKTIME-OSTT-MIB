-- 1.3.6.1.4.1.49224.2.5.1.2.0.1
osttDevGenStatusChange NOTIFICATION-TYPE
    OBJECTS         { osttDevGenObInStatus }
    STATUS          current
    DESCRIPTION	   "osttDevGenStatusChange"
    ::= { osttDevGenNotifications  1 }


--
--   C o n f o r m a n c e
--

-- conformance information

-- 1.3.6.1.4.1.49224.2.5.1.3
osttDevGenConformance     OBJECT IDENTIFIER ::= { osttDevGeneral 3 }

-- 1.3.6.1.4.1.49224.2.5.1.3.1
osttDevGenConCompliances     OBJECT IDENTIFIER ::= { osttDevGenConformance 1 }

-- 1.3.6.1.4.1.49224.2.5.1.3.2
osttDevGenConGroups          OBJECT IDENTIFIER ::= { osttDevGenConformance 2 }


-- compliance statements
-- 1.3.6.1.4.1.49224.2.5.1.3.1.1
osttDevGenCompliance MODULE-COMPLIANCE
    STATUS current
    DESCRIPTION
        "The  compliance statement for the MIB."
    MODULE -- this  module
    MANDATORY-GROUPS {
                      osttDevGenGroupInfo,
                      osttDevGenGroupNetwork,
                      osttDevGenGroupSysInfo,
                      osttDevGenGroupNotifications
                     }
    ::= { osttDevGenConCompliances 1 }

-- units of conformance

-- 1.3.6.1.4.1.49224.2.5.1.3.2.1
osttDevGenGroupInfo OBJECT-GROUP
    OBJECTS {
             osttDevGenObInTypeDefiniton,
             osttDevGenObInDataUpdate,
             osttDevGenObInVersionNumber,
             osttDevGenObInSerialNumber,
             osttDevGenObInStatus,
             osttDevGenObInLocation,
             osttDevGenObInGPSLocation,
             osttDevGenObInSoftUpdate,
             osttDevGenObInProdDate
            }
    STATUS current
    DESCRIPTION
		"The collection of objects which are used to provide
         the general information."
    ::= {  osttDevGenConGroups 1 }

-- 1.3.6.1.4.1.49224.2.5.1.3.2.2
osttDevGenGroupNetwork OBJECT-GROUP
    OBJECTS {
             osttDevGenObNetMacAddress,
             osttDevGenObNetIpAddress,
             osttDevGenObNetIpMask,
             osttDevGenObNetIpGate,
             osttDevGenObNetEthInterface ,
             osttDevGenObNetEthMode,
             osttDevGenObNetHostname
            }
    STATUS current
    DESCRIPTION
        "The collection of objects which are used to provide
         the network information."
    ::= {  osttDevGenConGroups 2 }

osttDevGenGroupSysInfo OBJECT-GROUP
    OBJECTS {
             osttDevGenSysName,
             osttDevGenSysType
            }
    STATUS current
    DESCRIPTION
        "The collection of objects which are used to provide
         the system information."
    ::= {  osttDevGenConGroups 3 }

