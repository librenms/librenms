   -- PSE Objects

     alaPethPsePortTable OBJECT-TYPE
          SYNTAX      SEQUENCE OF AlaPethPsePortEntry
          MAX-ACCESS  not-accessible
          STATUS      current
          DESCRIPTION
              "A table of objects that augments the standard pethPsePortTable
              entry. To apply the configuration on all the ports in the slot, the end port index must be set to MAX(2147483647)."
          ::= { alaPethObjects 1 }

     alaPethPsePortEntry OBJECT-TYPE
          SYNTAX      AlaPethPsePortEntry
          MAX-ACCESS  not-accessible
          STATUS      current
          DESCRIPTION
                  "A set of objects that display and control the power
                  characteristics of a power Ethernet PSE port."
          AUGMENTS  { pethPsePortEntry }
          ::= { alaPethPsePortTable 1 }


     AlaPethPsePortEntry ::= SEQUENCE {
           alaPethPsePortPowerMaximum
                INTEGER,
           alaPethPsePortPowerActual
                INTEGER,
           alaPethPsePortPowerStatus
                INTEGER,
           alaPethPsePortPowerClass
                INTEGER,
           alaPethPsePort4PairStatus
                INTEGER,
           alaPethPsePortPowerOverHdmi
                INTEGER,
           alaPethPsePortPowerClassA
                INTEGER,
           alaPethPsePortPowerClassB
                INTEGER,
           alaPethPsePortTrusted
                INTEGER,
           alaPethPsePortDot3bt
                INTEGER,
           alaPethPsePortCapacitorDetection
                INTEGER,
           alaPethPsePortAutoClass
                INTEGER,
           alaPethPsePortReset
                INTEGER,
           alaPethPsePortSwapAltPairsets
                INTEGER
        }

     alaPethPsePortPowerMaximum OBJECT-TYPE
       SYNTAX INTEGER ( 3000 .. 95000 )
       MAX-ACCESS read-write
       STATUS current
       DESCRIPTION
           "This object controls maximum amount of power per port."
       ::= { alaPethPsePortEntry 1 }

     alaPethPsePortPowerActual OBJECT-TYPE
       SYNTAX INTEGER ( 0 .. 95000 )
       MAX-ACCESS read-only
       STATUS current
       DESCRIPTION
           "This object contains the actual amount of power used by a port"
       ::= { alaPethPsePortEntry 2 }

     alaPethPsePortPowerStatus OBJECT-TYPE
       SYNTAX INTEGER   {
                  powerOn (1),
                  powerOff (2),
                  searching (3),
                  fault (4),
                  test (5),
                  denied (6),
                  badVoltInj (7),
                  violation (8)
           }
       MAX-ACCESS read-only
       STATUS current
       DESCRIPTION
           "This object contains the power status of a port"
       ::= { alaPethPsePortEntry 3 }
       
     alaPethPsePortPowerClass OBJECT-TYPE
       SYNTAX INTEGER  {
                class0 (0), 
                class1 (1), 
                class2 (2), 
                class3 (3), 
                class4 (4), 
                class5 (5), 
                classStop (6), 
                classUnknown (7), 
                portNotPowered (8), 
                classDetectDisabled (9), 
                niNotPowered (10), 
                class6 (11), 
                class7 (12), 
                class8 (13) 
                }
       MAX-ACCESS read-only
       STATUS current
       DESCRIPTION
           "This object controls class of poe device attached on a port.
            NoDetection - Bt detection is not happened
            class1 - The device can draw PD power upto 3.84W (SSPD) or 7.68W (DSPD).
            class2 - The device can draw PD power upto 6.49W (SSPD) or 12.98W (DSPD).
            class3 - The device can draw PD power upto 12.95W (SSPD) or 26W (DSPD).
            class4 - The device can draw PD power upto 25.5W (SSPD) or 51W (DSPD).
            class5 - The device can draw PD power upto 40W(SSPD) or 71.2W (DSPD).
            class6 - The device can draw PD power upto 51W (SSPD).
            class7 - The device can draw PD power upto 62W (SSPD).
            class8 - The device can draw PD power upto 71.3W (SSPD).
            classStop -
            classUnknown -
            portNotPowered - Port is not powered.
            classDetectDisabled - Class detection is disabled.
            niNotPowered - NI is not powered.
            Note:
                - SSPD - Single Signature PD
                - DSPD - Dual signature PD"

       ::= { alaPethPsePortEntry 4 }

     alaPethPsePort4PairStatus OBJECT-TYPE
       SYNTAX INTEGER   {
              enable(1),
              disable(2)
         }
      MAX-ACCESS  read-write
      STATUS      current
      DESCRIPTION
              "The object is used to enable or disable port as 4pair or 2pair port.
              Enabling will set the port as 4pair port and disabling will set the 
              port as 2pair port."
      ::= { alaPethPsePortEntry 5 }

     alaPethPsePortPowerOverHdmi OBJECT-TYPE
       SYNTAX INTEGER   {
              enable(1),
              disable(2)
         }
      MAX-ACCESS  read-write
      STATUS      current
      DESCRIPTION
              "The object is used to enable or disable power over HDMI."
      DEFVAL { disable }
      ::= { alaPethPsePortEntry 6 }
     
     alaPethPsePortPowerClassA OBJECT-TYPE
       SYNTAX INTEGER   {
                class1 (1), 
                class2 (2), 
                class3 (3), 
                class4 (4), 
                class5 (5), 
                classStop (6), 
                classUnknown (7), 
                portNotPowered (8), 
                classDetectDisabled (9), 
                niNotPowered (10), 
                class6 (11), 
                class7 (12), 
                class8 (13) 
         }
      MAX-ACCESS  read-only
      STATUS      current
      DESCRIPTION
           "This object controls class of poe device attached on a port.
            class1 - The device can draw PD power upto 3.84W (SSPD) or 7.68W (DSPD).
            class2 - The device can draw PD power upto 6.49W (SSPD) or 12.98W (DSPD).
            class3 - The device can draw PD power upto 12.95W (SSPD) or 26W (DSPD).
            class4 - The device can draw PD power upto 25.5W (SSPD) or 51W (DSPD).
            class5 - The device can draw PD power upto 40W(SSPD) or 71.2W (DSPD).
            class6 - The device can draw PD power upto 51W (SSPD).
            class7 - The device can draw PD power upto 62W (SSPD).
            class8 - The device can draw PD power upto 71.3W (SSPD).
            classStop -
            classUnknown -
            portNotPowered - Port is not powered.
            classDetectDisabled - Class detection is disabled.
            niNotPowered - NI is not powered.
            Note:
                - SSPD - Single Signature PD
                - DSPD - Dual signature PD"
      REFERENCE
            "IEEE Std 802.3bt Section 30.9.1.1.6a
             aPSEPowerClassificationA"
      ::= { alaPethPsePortEntry 7 }
      
     alaPethPsePortPowerClassB OBJECT-TYPE
       SYNTAX INTEGER   {
                class1 (1), 
                class2 (2), 
                class3 (3), 
                class4 (4), 
                class5 (5), 
                classStop (6), 
                classUnknown (7), 
                portNotPowered (8), 
                classDetectDisabled (9), 
                niNotPowered (10), 
                class6 (11), 
                class7 (12), 
                class8 (13) 
         }
      MAX-ACCESS  read-only
      STATUS      current
      DESCRIPTION
           "This object controls class of poe device attached on a port.
            class1 - The device can draw PD power upto 3.84W (SSPD) or 7.68W (DSPD).
            class2 - The device can draw PD power upto 6.49W (SSPD) or 12.98W (DSPD).
            class3 - The device can draw PD power upto 12.95W (SSPD) or 26W (DSPD).
            class4 - The device can draw PD power upto 25.5W (SSPD) or 51W (DSPD).
            class5 - The device can draw PD power upto 40W(SSPD) or 71.2W (DSPD).
            class6 - The device can draw PD power upto 51W (SSPD).
            class7 - The device can draw PD power upto 62W (SSPD).
            class8 - The device can draw PD power upto 71.3W (SSPD).
            classStop -
            classUnknown -
            portNotPowered - Port is not powered.
            classDetectDisabled - Class detection is disabled.
            niNotPowered - NI is not powered.
            Note:
                - SSPD - Single Signature PD
                - DSPD - Dual signature PD"
      REFERENCE
            "IEEE Std 802.3bt Section 30.9.1.1.6b
             aPSEPowerClassificationB"
      ::= { alaPethPsePortEntry 8 }

     alaPethPsePortTrusted  OBJECT-TYPE
       SYNTAX INTEGER   {
              enable(1),
              disable(2)
         }
      MAX-ACCESS  read-write
      STATUS      current
      DESCRIPTION
              "The object is used to configure the PoE port as trusted or untrusted."
