                   d11(10),d12(11),d13(12),d14(13),d15(14),d16(15),d17(16),d18(17),d19(18),d20(19),
                   d21(20),d22(21),d23(22),d24(23),d25(24),d26(25),d27(26),d28(27),d29(28),d30(29),
