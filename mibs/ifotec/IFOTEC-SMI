ifotec MODULE-IDENTITY
    LAST-UPDATED    "202610080000Z"
    ORGANIZATION    "IFOTEC"
    CONTACT-INFO    "contact@ifotec.com"
    DESCRIPTION
        "The Structure of Management Information for the
        IFOTEC enterprise."	
    REVISION      "202610080000Z"
    DESCRIPTION
            "Add dot1x(256) to ifoLogNotifType."
    REVISION      "202609300000Z"
    DESCRIPTION
            "Add IfotecTenthCelsius and IfotecTenthDbm, with DISPLAY-HINT
            and UNITS, for temperatures and optical powers; align the
            SEQUENCE types of ifoTemperatureEntry and ifoSFPEntry on
            their objects; fix the description of the low warning
            thresholds."
    REVISION      "202609230000Z"
    DESCRIPTION
            "Fix enums for ifoLogNotifType."
    REVISION      "202407050000Z"
    DESCRIPTION
            "Add DAC SFP type."
    REVISION      "202402090000Z"
    DESCRIPTION
            "Fix ifoSFPIfoSysIndex."
    REVISION      "202104130000Z"
    DESCRIPTION
            "Add ifotecLog and ifotecSFP node."
    REVISION      "202101150000Z"
    DESCRIPTION
            "Add ifotecIO node."
    REVISION      "202007280000Z"
    DESCRIPTION
            "First iteration of the MIB."		
		
     ::= { enterprises 21362 }

IfotecYesNoType ::= TEXTUAL-CONVENTION
	STATUS             current
	DESCRIPTION   "Yes,No enum."
	SYNTAX  INTEGER {
		yes(1),
		no(2)
	}


IfotecSFPConnectorType ::= TEXTUAL-CONVENTION
	STATUS             current
	DESCRIPTION   "SFP Connector type enum."
	SYNTAX  INTEGER {
		undefined(1),
		sc(2),
		lc(3),
		rj45(4),
		dac(5)
	}
	 
IfotecDataStatus ::= TEXTUAL-CONVENTION
	STATUS             current
	DESCRIPTION   "Represents the data status."
	SYNTAX  INTEGER {
		noData(1),
		ok(2),
		warning(3),
		warningLowThreshold(4),
		warningHighThreshold(5),
		error(6),
		errorLowThreshold(7),
		errorHighThreshold(8),
		errorWrongData(9),
		errorLowDataOverflow(10),
		errorHighDataOverflow(11)
	}

IfotecDigitalValue ::= TEXTUAL-CONVENTION
	STATUS             current
	DESCRIPTION   "Represents the value of digital input/output."
	SYNTAX  INTEGER {
		active(1),
		inactive(2)
	}	
	
IfotecDigitalInputType ::= TEXTUAL-CONVENTION
	STATUS             current
	DESCRIPTION   "Represents the type of digital input."
	SYNTAX  INTEGER {
		dryContact(1), -- when pins are connected, input is active.
		wetContact(2)  -- when voltage is applied between pins, input is active.
	}
	
IfotecDigitalOutputType ::= TEXTUAL-CONVENTION
	STATUS             current
	DESCRIPTION   "Represents the type of digital output."
	SYNTAX  INTEGER {
		relayComNo(1),  -- 2-pin relay (Common, Normally Open). When output is active, relay is opened.
		relayComNc(2),  -- 2-pin relay (Common, Normally Closed). When output is active, relay is closed.
		relayNoComNc(3) -- 3-pin relay (Normally Open, Common, Normally Closed). When output is active, relay is opened between COM and NO contact. When output is active, relay is closed between COM and NC contact.
	}

IfotecTenthCelsius ::= TEXTUAL-CONVENTION
	DISPLAY-HINT       "d-1"
	STATUS             current
	DESCRIPTION   "A temperature, in tenths of degree Celsius:
		the value 235 is 23.5 degrees Celsius."
	SYNTAX  Integer32

IfotecTenthDbm ::= TEXTUAL-CONVENTION
	DISPLAY-HINT       "d-1"
	STATUS             current
	DESCRIPTION   "An optical power, in tenths of dBm:
		the value -52 is -5.2 dBm."
	SYNTAX  Integer32

IfotecSFPmodeType ::= TEXTUAL-CONVENTION
	STATUS             current
	DESCRIPTION   "SFP mode."
	SYNTAX  INTEGER {
		undefined(1),
