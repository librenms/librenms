	ifoSFPmode         			IfotecSFPmodeType,
	ifoSFPrxSignalDetect		IfotecYesNoType,
	ifoSFPAlarmeOptEnb			IfotecYesNoType,
	ifoSFPAlarmeOptStatus		IfotecDataStatus,
	ifoSFPrxPowerVal			IfotecTenthDbm,
	ifoSFPrxPowerErrThsdHigh	IfotecTenthDbm,
	ifoSFPrxPowerErrThsdLow		IfotecTenthDbm,
	ifoSFPrxPowerWrngThsdHigh	IfotecTenthDbm,
	ifoSFPrxPowerWrngThsdLow	IfotecTenthDbm,
	ifoSFPrxPowerStatus			IfotecDataStatus,
	ifoSFPtxPowerVal			IfotecTenthDbm,
	ifoSFPtxPowerErrThsdHigh	IfotecTenthDbm,
	ifoSFPtxPowerErrThsdLow		IfotecTenthDbm,
	ifoSFPtxPowerWrngThsdHigh	IfotecTenthDbm,
	ifoSFPtxPowerWrngThsdLow	IfotecTenthDbm,
	ifoSFPtxPowerStatus			IfotecDataStatus
}	

ifoSFPIfoSysIndex 			OBJECT-TYPE SYNTAX Integer32 				MAX-ACCESS not-accessible 	STATUS current
	 DESCRIPTION "The index value which uniquely identifies the system in ifoSysMibTable."	::= { ifoSFPEntry 1 }
ifoSFPIndex 				OBJECT-TYPE SYNTAX Integer32 				MAX-ACCESS not-accessible 	STATUS current
	 DESCRIPTION "A unique value, greater than zero, for each SFP."							::= { ifoSFPEntry 2  }
ifoSFPportName 				OBJECT-TYPE SYNTAX DisplayString 			MAX-ACCESS read-only 		STATUS current
	 DESCRIPTION "The name of the port."													::= { ifoSFPEntry 3  }
ifoSFPisPlugged 			OBJECT-TYPE SYNTAX IfotecYesNoType 			MAX-ACCESS read-only 		STATUS current
	 DESCRIPTION "Indicates the presence of the SFP."										::= { ifoSFPEntry 4 }
ifoSFPConnectorType    		OBJECT-TYPE SYNTAX IfotecSFPConnectorType	MAX-ACCESS read-only 		STATUS current
	 DESCRIPTION "Indicates the type of the SFP connector."									::= { ifoSFPEntry 5 }
ifoSFPmode 					OBJECT-TYPE SYNTAX IfotecSFPmodeType		MAX-ACCESS read-only 		STATUS current
	 DESCRIPTION "Indicates the operating mode of the SFP."									::= { ifoSFPEntry 6 }
ifoSFPrxSignalDetect		OBJECT-TYPE SYNTAX IfotecYesNoType	 		MAX-ACCESS read-only		STATUS current
	 DESCRIPTION "Indicates the presence of Rx optical signal."		         				::= { ifoSFPEntry 7  }
ifoSFPAlarmeOptEnb			OBJECT-TYPE SYNTAX IfotecYesNoType	 		MAX-ACCESS read-only		STATUS current
	 DESCRIPTION "Indicates if the optical alarm is enabled."		         				::= { ifoSFPEntry 8  }
ifoSFPAlarmeOptStatus		OBJECT-TYPE SYNTAX IfotecDataStatus	 		MAX-ACCESS read-only		STATUS current
	 DESCRIPTION "Indicates the status of the optical alarm."		         				::= { ifoSFPEntry 9  }
ifoSFPrxPowerVal 			OBJECT-TYPE SYNTAX IfotecTenthDbm UNITS "dBm"				MAX-ACCESS read-only		STATUS current
