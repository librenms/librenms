ifotecLog OBJECT-IDENTITY STATUS current DESCRIPTION     "IFOTEC Logs." ::= { ifotecGeneral 4 }

ifoLogNotifLastIdSend
	OBJECT-TYPE SYNTAX Integer32	 	MAX-ACCESS read-only 			  STATUS current
	DESCRIPTION "ID of the last notif send." 	 											::= { ifotecLog 1 } 

ifotecLogNotif OBJECT-IDENTITY STATUS current DESCRIPTION     "IFOTEC Log Notifications." 	::= { ifotecLog 2 }

ifoLogNotifSysIndex
	OBJECT-TYPE SYNTAX Integer32 	 	MAX-ACCESS accessible-for-notify STATUS current
	DESCRIPTION "The index value which uniquely identifies the system in ifoSysMibTable."	::= { ifotecLogNotif 1 } 
ifoLogNotifId
	OBJECT-TYPE SYNTAX Integer32 	 	MAX-ACCESS accessible-for-notify STATUS current
	DESCRIPTION "ID of the Notification." 			     									::= { ifotecLogNotif 2 } 
ifoLogNotifTimestamp
	OBJECT-TYPE SYNTAX Integer32 	 	MAX-ACCESS accessible-for-notify STATUS current
	DESCRIPTION "Timestamp of the event." 		 											::= { ifotecLogNotif 3 }
ifoLogNotifType
	OBJECT-TYPE SYNTAX INTEGER  { alarm(1), reboot(2), portStatusChange(4), connexion(8), sntp(16), configChange(32), poeEvent(64), ioChange(128), dot1x(256) }
									 	MAX-ACCESS accessible-for-notify STATUS current
	DESCRIPTION "Type of the event. One value per event, never a combination:
                 the powers of two come from the logging filter, which uses them
                 as a mask elsewhere. Do not convert to BITS: the agent sends a
                 single ENUM_LOG_TYPE. Values are the same on all products.
                 poeEvent(64) is emitted only by PoE products, ioChange(128)
                 only by products with digital inputs." 		     											::= { ifotecLogNotif 4 }
ifoLogNotifSequence
	OBJECT-TYPE SYNTAX Integer32 	 	MAX-ACCESS accessible-for-notify STATUS current
	DESCRIPTION "Sequence number of the event."  											::= { ifotecLogNotif 5 }
ifoLogNotifDesc 
	OBJECT-TYPE SYNTAX DisplayString 	MAX-ACCESS accessible-for-notify STATUS current
	DESCRIPTION "Description of the event."		 											::= { ifotecLogNotif 6 }
ifoLogNotifStatus
	OBJECT-TYPE SYNTAX IfotecDataStatus	MAX-ACCESS accessible-for-notify STATUS current
	DESCRIPTION "Status of the event."			 											::= { ifotecLogNotif 7 }
ifoLogNotifSeverity
	OBJECT-TYPE SYNTAX INTEGER  { emergency(0), alert(1), critical(2), error(3), warning(4), notice(5), informational(6), debug(7) }
								 	 	MAX-ACCESS accessible-for-notify STATUS current
	DESCRIPTION "Severity of the event." 		 											::= { ifotecLogNotif 8 }

