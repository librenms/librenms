-- Alarm Control Objects
-- ****************************************************************************
    aviatIetfMaxAlarmStatusChanges  OBJECT-TYPE
        SYNTAX          Gauge32
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION     "The maximum number of alarm status changes for a given
                         alarm instance. Historic status change entries are
                         kept in a circular list per alarm. When this number is
                         exceeded, the oldest status change entry is
                         automatically removed."
            ::= { aviatIetfAlarmControl 1 }

    aviatIetfAlarmNotificationControl   OBJECT-TYPE
        SYNTAX          AviatIetfAlarmNotificationControlMethod
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION     "The alarm notifiaction types that the system will
                         transmit."
            ::= { aviatIetfAlarmControl 2 }


-- ****************************************************************************
-- Aviat IETF Alarm Shelving Control Table
-- ****************************************************************************
    aviatIetfAlarmShelvingControlTable  OBJECT-TYPE
        SYNTAX          SEQUENCE OF AviatIetfAlarmShelvingControlEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION     "This table shows how the system is configured to
                         shelve (block/filter) alarms. Any alarms corresponding
                         to the shelving criteria will be moved from the alarms
                         list to the shelved alarms list. No notifications will
                         be sent for shelved alarms. The conditions in the
                         shelf criteria are logically ANDed. When the shelving
                         criteria is deleted or changed by the system, the
                         non-matching alarms will appear in the alarms list
                         according to their real state."
            ::= { aviatIetfAlarmControl 3 }

    aviatIetfAlarmShelvingControlEntry  OBJECT-TYPE
        SYNTAX          AviatIetfAlarmShelvingControlEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION     "Each entry defines the criteria for shelving alarms.
                         Criteria are ANDed. If no criteria are specified, all
                         alarms will be shelved."
        INDEX           { IMPLIED aviatIetfAlarmShelvingControlName }
            ::= { aviatIetfAlarmShelvingControlTable 1 }

    AviatIetfAlarmShelvingControlEntry ::=
        SEQUENCE {
            aviatIetfAlarmShelvingControlName
                DisplayString,
            aviatIetfAlarmShelvingControlResource
                DisplayString,
            aviatIetfAlarmShelvingControlAlarmTypeId
                DisplayString,
            aviatIetfAlarmShelvingControlAlarmTypeQualifierMatch
                DisplayString,
            aviatIetfAlarmShelvingControlDescription
                DisplayString
        }

    aviatIetfAlarmShelvingControlName   OBJECT-TYPE
        SYNTAX          DisplayString
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION     "An arbitrary name for the alarm shelf entry."
            ::= { aviatIetfAlarmShelvingControlEntry 1 }

    aviatIetfAlarmShelvingControlResource   OBJECT-TYPE
        SYNTAX          DisplayString
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION     "Shelve alarms for matching resources."
            ::= { aviatIetfAlarmShelvingControlEntry 2 }

    aviatIetfAlarmShelvingControlAlarmTypeId    OBJECT-TYPE
        SYNTAX          DisplayString
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION     "Shelve all alarms that have an Alarm Type ID that is
                         equal to or derived from the given Alarm Type ID."
            ::= { aviatIetfAlarmShelvingControlEntry 3 }

    aviatIetfAlarmShelvingControlAlarmTypeQualifierMatch    OBJECT-TYPE
        SYNTAX          DisplayString
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION     "A W3C regular expression that is used to match an
                         Alarm Type Qualifier. All alarms that match this
                         regular expression will be shelved."
            ::= { aviatIetfAlarmShelvingControlEntry 4 }

    aviatIetfAlarmShelvingControlDescription    OBJECT-TYPE
        SYNTAX          DisplayString
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION     "An optional textual description of the shelf control
                         entry. This description should include the reason for
                         shelving these alarms."
            ::= { aviatIetfAlarmShelvingControlEntry 5 }


