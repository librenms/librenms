    AviatIetfAlarmNotificationControlMethod ::= TEXTUAL-CONVENTION
        STATUS          current
        DESCRIPTION     "Defines possible SNMP notification control settings."
        SYNTAX          INTEGER {
                                    allStateChanges (1),
                                    allRaiseAndClearEvents (2),
                                    minimumIndeterminateSevAndClearEvents (3),
                                    minimumWarningSevAndClearEvents (4),
                                    minimumMinorSevAndClearEvents (5),
                                    minimumMajorSevAndClearEvents (6),
                                    minimumCriticalSevAndClearEvents (7)
                                }

    AviatIetfAlarmEntryThresholdType ::= TEXTUAL-CONVENTION
        STATUS          current
        DESCRIPTION     "For alarms that are triggered when a measured value is
                         exceeded, defines whether an alarm instance relates to
                         an upper or lower threshold being crossed."
        SYNTAX          INTEGER {
                                    upperThreshold (1),
                                    lowerThreshold (2),
                                    noThresholdAssociation (3)
                                }

