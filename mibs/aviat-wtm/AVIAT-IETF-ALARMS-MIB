-- ****************************************************************************
-- Aviat IETF Alarm Inventory Table
-- ****************************************************************************
    aviatIetfAlarmInventoryTable    OBJECT-TYPE
        SYNTAX          SEQUENCE OF AviatIetfAlarmInventoryEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION     "A table of all possible alarm types for the system. If
                         the system knows for which resources a specific alarm
                         type can appear, this is also identified in the
                         inventory."
            ::= { aviatIetfAlarmInventory 1 }

    aviatIetfAlarmInventoryEntry    OBJECT-TYPE
        SYNTAX          AviatIetfAlarmInventoryEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION     "An entry in this table defines a possible alarm."
        INDEX           { aviatIetfAlarmInventoryAlarmTypeId,
                          aviatIetfAlarmInventoryAlarmTypeQualifier }
            ::= { aviatIetfAlarmInventoryTable 1 }

    AviatIetfAlarmInventoryEntry ::=
        SEQUENCE {
            aviatIetfAlarmInventoryAlarmTypeId
                DisplayString,
            aviatIetfAlarmInventoryAlarmTypeQualifier
                DisplayString,
            aviatIetfAlarmInventoryAlarmResources
                DisplayString,
            aviatIetfAlarmInventoryAlarmHasClear
                TruthValue,
            aviatIetfAlarmInventoryAlarmSeverityLevels
                DisplayString,
            aviatIetfAlarmInventoryAlarmDescription
                DisplayString,
            aviatIetfAlarmInventoryAlarmEventType
                IANAItuEventType,
            aviatIetfAlarmInventoryAlarmProbableCause
                IANAItuProbableCause,
            aviatIetfAlarmInventoryAlarmProbableCauseString
                DisplayString
        }

    aviatIetfAlarmInventoryAlarmTypeId  OBJECT-TYPE
        SYNTAX          DisplayString
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION     "The statically defined alarm type identifier for this
                         possible alarm."
            ::= { aviatIetfAlarmInventoryEntry 1 }

    aviatIetfAlarmInventoryAlarmTypeQualifier   OBJECT-TYPE
        SYNTAX          DisplayString
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION     "The optionally dynamically defined alarm type
                         identifier for this possible alarm."
            ::= { aviatIetfAlarmInventoryEntry 2 }

    aviatIetfAlarmInventoryAlarmResources   OBJECT-TYPE
        SYNTAX          DisplayString
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION     "Optionally, a comma separated list of resources that
                         the alarm type is valid for."
