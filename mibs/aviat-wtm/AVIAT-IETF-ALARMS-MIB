-- ****************************************************************************
-- Aviat IETF Alarm List Table
-- ****************************************************************************
    aviatIetfAlarmListTable     OBJECT-TYPE
        SYNTAX          SEQUENCE OF AviatIetfAlarmListEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION     "The list of alarms. Each entry in the list holds one
                         alarm for a given alarm type and resource."
            ::= { aviatIetfAlarmList 3 }

    aviatIetfAlarmListEntry     OBJECT-TYPE
        SYNTAX          AviatIetfAlarmListEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION     "Entries appear in the alarm list the first time an
                         alarm becomes active for a given alarm type and
                         resource. Entries do not get deleted when the alarm is
                         cleared, this is a boolean state in the alarm.

                         Alarm entries are removed from the list by an explicit
                         purge action performed by the operator."
        INDEX           { aviatIetfAlarmListResource,
                          aviatIetfAlarmListAlarmTypeId,
                          aviatIetfAlarmListAlarmTypeQualifier }
            ::= { aviatIetfAlarmListTable 1 }

    AviatIetfAlarmListEntry ::=
        SEQUENCE {
            aviatIetfAlarmListResource
                DisplayString,
            aviatIetfAlarmListAlarmTypeId
                DisplayString,
            aviatIetfAlarmListAlarmTypeQualifier
                DisplayString,
            aviatIetfAlarmListTimeCreated
                DateAndTime,
            aviatIetfAlarmListIsCleared
                TruthValue,
            aviatIetfAlarmListLastStateChange
                DateAndTime,
            aviatIetfAlarmListPerceivedSeverity
                ItuPerceivedSeverity,
            aviatIetfAlarmListAlarmText
                DisplayString,
            aviatIetfAlarmListEventType
                IANAItuEventType,
            aviatIetfAlarmListProbableCause
                IANAItuProbableCause,
            aviatIetfAlarmListProbableCauseString
                DisplayString,
            aviatIetfAlarmListTrendIndication
                ItuTrendIndication,
            aviatIetfAlarmListObservedValue
                Integer32,
            aviatIetfAlarmListThresholdType
                AviatIetfAlarmEntryThresholdType,
            aviatIetfAlarmListRaiseThresholdValue
                Integer32,
            aviatIetfAlarmListClearThresholdValue
                Integer32,
            aviatIetfAlarmListLastClearedTime
                DateAndTime
        }

    aviatIetfAlarmListResource  OBJECT-TYPE
        SYNTAX          DisplayString
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION     "The alarming resource. This could for example be a
                         reference to the alarming interface."
            ::= { aviatIetfAlarmListEntry 1 }

    aviatIetfAlarmListAlarmTypeId   OBJECT-TYPE
        SYNTAX          DisplayString
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION     "An identifier for this alarm type."
            ::= { aviatIetfAlarmListEntry 2 }

    aviatIetfAlarmListAlarmTypeQualifier    OBJECT-TYPE
        SYNTAX          DisplayString
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION     "A secondary identifier for the alarm type which
                         together with aviatIetfAlarmListAlarmTypeId uniquely
                         identifies a specific alarm type."
            ::= { aviatIetfAlarmListEntry 3 }

    aviatIetfAlarmListTimeCreated   OBJECT-TYPE
        SYNTAX          DateAndTime
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION     "The time-stamp when this alarm entry was created. This
                         represents the first time the alarm appeared. It can
                         also represent that the alarm re-appeared after a
                         purge."
            ::= { aviatIetfAlarmListEntry 4 }

    aviatIetfAlarmListIsCleared OBJECT-TYPE
        SYNTAX          TruthValue
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION     "Indicates the current clearance state of the alarm. An
                         alarm might toggle from active alarm to cleared alarm
                         and back to active again."
            ::= { aviatIetfAlarmListEntry 5 }

    aviatIetfAlarmListLastStateChange   OBJECT-TYPE
        SYNTAX          DateAndTime
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION     "The timestamp when the alarm status was last changed.
                         Status changes occur when the values of
                         aviatIetfAlarmListAlarmIsCleared,
                         aviatIetfAlarmListAlarmPerceivedSeverity or
                         aviatIetfAlarmListAlarmText change for the alarm."
            ::= { aviatIetfAlarmListEntry 6 }

    aviatIetfAlarmListPerceivedSeverity OBJECT-TYPE
        SYNTAX          ItuPerceivedSeverity
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION     "The last severity level of the alarm.

                         If the alarm was raised with severity 'warning', but
                         later changed to 'major', this object will show
                         'major'."
            ::= { aviatIetfAlarmListEntry 7 }

    aviatIetfAlarmListAlarmText OBJECT-TYPE
        SYNTAX          DisplayString
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION     "The last reported alarm text."
            ::= { aviatIetfAlarmListEntry 8 }

    aviatIetfAlarmListEventType OBJECT-TYPE
        SYNTAX          IANAItuEventType
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION     "The X.733/X.736 event type for this alarm."
            ::= { aviatIetfAlarmListEntry 9 }

    aviatIetfAlarmListProbableCause OBJECT-TYPE
        SYNTAX          IANAItuProbableCause
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION     "The X.733 probable cause for this alarm."
            ::= { aviatIetfAlarmListEntry 10 }

    aviatIetfAlarmListProbableCauseString   OBJECT-TYPE
        SYNTAX          DisplayString
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION     "The user friendly string matching the value of
                         aviatIetfAlarmListProbableCause. The string SHOULD
                         match the X.733 enumeration."
            ::= { aviatIetfAlarmListEntry 11 }

    aviatIetfAlarmListTrendIndication   OBJECT-TYPE
        SYNTAX          ItuTrendIndication
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION     "This parameter specifies the current severity trend of
                         the resource. If present it indicates that there are
                         one or more alarms ('outstanding alarms') which have
                         not been cleared, and pertain to the same resource as
                         that to which this alarm ('current alarm') pertains.
                         The possible values are:

                         more-severe: The Perceived severity in the current
                         alarm is higher (more severe) than that reported in
                         any of the outstanding alarms.

                         no-change: The Perceived severity reported in the
                         current alarm is the same as the highest (most severe)
                         of any of the outstanding alarms.

                         less-severe: There is at least one outstanding alarm
                         of a severity higher (more severe) than that in the
                         current alarm."
            ::= { aviatIetfAlarmListEntry 12 }

    aviatIetfAlarmListObservedValue OBJECT-TYPE
        SYNTAX          Integer32
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION     "The observed value of the monitored resource when this
                         entry was created. The measured units are specific to
                         the resource."
            ::= { aviatIetfAlarmListEntry 13 }

    aviatIetfAlarmListThresholdType OBJECT-TYPE
        SYNTAX          AviatIetfAlarmEntryThresholdType
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION     "The type of threshold that was crossed when this alarm
                         list entry was created (upper, lower or none)."
            ::= { aviatIetfAlarmListEntry 14 }

    aviatIetfAlarmListRaiseThresholdValue   OBJECT-TYPE
        SYNTAX          Integer32
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION     "This object depends on the value of
                         aviatIetfAlarmListThresholdType as follows:

                         upperThreshold = the highest acceptable value of the
                                          monitored resource. If this threshold
                                          is crossed an alarm will be raised.

                         lowerThreshold = the lowest acceptable value of the
                                          monitored resource. If this threshold
                                          is crossed an alarm will be raised.

                         noThresholdAssociation = this object has no meaning.

                         The value is effectively part of a scale and measured
                         units are not specified for the monitored resource."
            ::= { aviatIetfAlarmListEntry 15 }

    aviatIetfAlarmListClearThresholdValue   OBJECT-TYPE
        SYNTAX          Integer32
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION     "This object depends on the value of
                         aviatIetfAlarmListThresholdType as follows:

                         upperThreshold = the highest acceptable value of the
                                          monitored resource to enable an alarm
                                          for it to be cleared once it has been
                                          raised.

                         lowerThreshold = the lowest acceptable value of the
                                          monitored resource to enable an alarm
                                          for it to be cleared once it has been
                                          raised.

                         noThresholdAssociation = this object has no meaning.

                         The value is effectively part of a scale and measured
                         units are not specified for the monitored resource."
            ::= { aviatIetfAlarmListEntry 16 }

    aviatIetfAlarmListLastClearedTime   OBJECT-TYPE
        SYNTAX          DateAndTime
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION     "The time at which the system last started monitoring
                         the resource for an alarm condition."
            ::= { aviatIetfAlarmListEntry 17 }


-- ****************************************************************************
-- Aviat IETF Alarm Status History Table
-- ****************************************************************************
    aviatIetfAlarmStatusHistoryTable    OBJECT-TYPE
        SYNTAX          SEQUENCE OF AviatIetfAlarmStatusHistoryEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION     "A history of status change events for each alarm."
            ::= { aviatIetfAlarmList 4 }

    aviatIetfAlarmStatusHistoryEntry    OBJECT-TYPE
        SYNTAX          AviatIetfAlarmStatusHistoryEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION     "Entries in this table are ordered according to the
                         timestamps of alarm state changes. The last item
                         corresponds to the latest state change.

                         The following state changes create an entry in this
                         list:
                           - changed severity level (warning, minor, major,
                             critical)
                           - clearance status of the alarm
                           - an alarm text update."
