--
-- Textual conventions for the NTP subset
--
NTPTimeStamp ::= TEXTUAL-CONVENTION
    DISPLAY-HINT "2d-1d-1d,1d:1d:1d.2d"
    STATUS       current
    DESCRIPTION
            "A date-time specification.

            field  octets  contents                  range
            -----  ------  --------                  -----
              1      1-2   year*                     0..65536
              2       3    month                     1..12
              3       4    day                       1..31
              4       5    hour                      0..23
              5       6    minutes                   0..59
              6       7    seconds                   0..60
                           (use 60 for leap-second)
              7      8-9   milli-seconds*            0..999

            * Notes:
            - the value of year and milli-seconds is in network-byte order

            For example, Tuesday May 26, 1992 at 1:30:15 PM would be
            displayed as: 1992-5-26,13:30:15.0"
    SYNTAX OCTET STRING (SIZE (9))

NTPLeapIndicator ::= TEXTUAL-CONVENTION
    STATUS      current
    DESCRIPTION "two-bit code warning of an impending leap
                 second to be inserted in the NTP timescale."
    SYNTAX INTEGER {
        noWarning(0),
        addSecond(1),
        subtractSecond(2),
        alarm(3)
    }

NTPReachability ::= TEXTUAL-CONVENTION
    STATUS      current
    DESCRIPTION "Interpreted values from the peers bit shift register for reachability:
                 reachable    --> all 8 attempts to reach the peer have been successful
                 medium       --> more than 4 of 8 attempts to reach the peer have been successful
                 bad          --> less than 5 but more than 0 attempts to reach the peer have been successful
                 notreachable --> 0 attempts to reach the peer have been successful"
    SYNTAX INTEGER {
        notreachable(1),
        bad(2),
        medium(3),
        reachable(4)
    }

NTPTallyCode ::= TEXTUAL-CONVENTION
    STATUS      current
    DESCRIPTION "the peers tally code that expresses the way the NTP algorithm classifies the
                 peer:
                 reject    --> the peer is discarded as unreachable, synchronized to this server (synch loop)
                               or outrageous synchronisation distance
                 falsetick --> the peer is discarded by the intersection algorithm as a falseticker
                 excess    --> the peer is discarded as not among the first ten peers sorted by synchronization
                               distance and so is probably a poor candidate for further consideration
                 outlyer   --> the peer is discarded by the clustering algorithm as an outlyer
                 candidat  --> the peer is a survivor and a candidate for the combining algorithm
                 selected  --> the peer is a survivor, but not among the first six peers sorted by
                               synchronization distance. If the association is ephemeral, it may be demobilized
                               to conserve resources
                 syspeer   --> the peer has been declared the system peer and lends its variables to the system
                               variables
                 ppspeer   --> the peer has been declared the system peer and lends its variables to the system
                               variables. However, the actual system synchronization is derived from a pulse-per-
                               second (PPS) signal, either indirectly via the PPS reference clock driver or
                               directly via kernel interface."
    SYNTAX INTEGER {
        reject(0),
        falsetick(1),
        excess(2),
        outlyer(3),
        candidat(4),
        selected(5),
        syspeer(6),
        ppspeer(7)
    }

ntpAccuracy  OBJECT-TYPE
    SYNTAX      INTEGER { low(0), medium(1), high(2) }
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "calculated value which takes into account the following parameters:
                 - SyncModuleTimeSyncState
                 - ntpSysRootDelay
                 - ntpSysRootDispersion
                 - ntpSysStability"
    ::= { ntp 3 }

--
-- NTP System Group
--
ntpSysLeap OBJECT-TYPE
    SYNTAX      NTPLeapIndicator
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "two-bit code warning of an impending leap
                 second to be inserted in the NTP timescale."
    ::= { ntpSystem 1 }

ntpSysStratum OBJECT-TYPE
    SYNTAX      Integer32 (0..16)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "indicating the stratum of the local clock.
                 0    --> unspecified
                 1    --> primary reference (e.g.,, calibrated atomic clock,
                          radio clock)
                 2-15 --> secondary reference (via NTP)
                 16   --> invalid"
    ::= { ntpSystem 2 }

ntpSysPrecision OBJECT-TYPE
    SYNTAX      Integer32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "signed integer indicating the precision
                 of the various clocks, in seconds to the nearest power
                 of two."
    ::= { ntpSystem 3 }

ntpSysRootDelay OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "the total roundtrip delay to the primary
                 reference source at the root of the synchronization
                 subnet, in seconds"
    ::= { ntpSystem 4 }

ntpSysRootDispersion OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "the maximum error relative to the primary
                 reference source at the root of the synchronization
                 subnet, in seconds. Only positive values greater
                 than zero are possible"
    ::= { ntpSystem 5 }

ntpSysJitter OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "the jitter value of the NTP system in seconds"
    ::= { ntpSystem 6 }

ntpSysStability OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "NTP system stability in ppm"
    ::= { ntpSystem 7 }

ntpSysRefId OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "the particular reference clock. In the case of
                 stratum 0 (unspecified) or stratum 1 (primary reference
                 source), this is a four-octet, left-justified,zero-padded
                 ASCII string.In the case of stratum 2 and greater (secondary
                 reference) this is the four-octet Internet address of the
                 peer selected for synchronization."
    ::= { ntpSystem 8 }

ntpSysRefTime OBJECT-TYPE
    SYNTAX      NTPTimeStamp
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "the local time when the local clock was last
                 updated. If the local clock has never been synchronized,
                 the value is zero."
    ::= { ntpSystem 9 }

ntpSysPeer OBJECT-TYPE
    SYNTAX      OBJECT IDENTIFIER
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "the current synchronization source. The object identifier points
                 to the index element ntpPeersAssocId of ntpPeersVarTable that identifies
                 the table entries for the current system peer."
    ::= { ntpSystem 10 }

ntpKernelInfoMaxError OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "maximum error in seconds from kernel information."
    ::= { ntpSystem 11 }

ntpKernelInfoEstError OBJECT-TYPE
    SYNTAX      OCTET STRING
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "estimated error in seconds from kernel information."
    ::= { ntpSystem 12 }

