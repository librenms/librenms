--
-- Definitions for the states of the synchronization module
--
SyncModule OBJECT IDENTIFIER ::= { hopf8029NTSM 3 }

SyncModuleTimeLocal OBJECT-TYPE
    SYNTAX      DateAndTime
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "current date and time with local time base with
                 regard to time zone and daylight saving time configurations
                 of the sync module in which the expansion card is
                 inserted to"
    ::= { SyncModule 1 }

SyncModuleTimeDST OBJECT-TYPE
    SYNTAX      INTEGER { Off(0), On(1) }
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "indicator for daylight saving time of sync module"
    ::= { SyncModule 2 }

SyncModuleTimeDSTChange OBJECT-TYPE
    SYNTAX      INTEGER { Off(0), On(1) }
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "indicator of the sync module for the announcement of a
                 daylight saving time change either from standard time to daylight
                 saving time or vice versa. the announcement is switched on one
                 hour before the actual change."
    ::= { SyncModule 3 }

SyncModuleTimeLEAP OBJECT-TYPE
    SYNTAX      INTEGER { Off(0), On(1) }
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "indicator of the sync module for the announcement of the
                 insertion of a leap second into the current time scale.
                 the announcement is switched on one hour before the actual
                 insertion of the leap second occurs."
    ::= { SyncModule 4 }

SyncModuleTimeSyncState OBJECT-TYPE
    SYNTAX      DisplayString (SIZE (0..1))
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "synchronisation state of the sync module:
                 R --> radio synchronous with high precision
                 r --> radio synchronous with low precision
                 C --> crystal mode
                 I --> invalid time and date"
    ::= { SyncModule 5 }

SyncModuleTimeSyncStateInt OBJECT-TYPE
    SYNTAX      Integer32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "synchronisation state of the sync module as integer value:
                 3 --> radio synchronous with high precision
                 2 --> radio synchronous with low precision
                 1 --> crystal mode
                 0 --> invalid time and date"
    ::= { SyncModule 6 }

SyncModuleSource OBJECT-TYPE
    SYNTAX      DisplayString (SIZE (1..255)) 
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Defines the synchronization module source."
    ::= { SyncModule 7 }



