        INDEX { controlIpAddress, controlIpMask, controlTeminal}
        ::= { ipAccessControlTable 1 }

    IpAccessControlEntry ::= SEQUENCE {
        controlIpAddress    IpAddress,
        controlIpMask       IpAddress,
        controlTeminal      INTEGER,
        controlStatus       INTEGER
